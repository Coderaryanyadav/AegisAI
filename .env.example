# AegisAI Environment Configuration Template
# Copy this file to '.env' and fill in your custom values.

# Port for the FastAPI backend (default is 8000)
# PORT=8000

# Base database URL. Defaults to local SQLite file in ~/.aegis_ai
# For PostgreSQL deployments, use: postgresql://username:password@localhost/db_name
# DATABASE_URL=sqlite:////Users/username/.aegis_ai/aegis_ai.db

# Master Key for encrypting files in the Document Vault.
# If unset, AegisAI will generate a key securely using the OS Keyring.
# To set manually, use a base64-encoded 32-byte Fernet key (e.g. from cryptography.fernet.Fernet.generate_key()).
# AEGIS_MASTER_KEY=

# Secret key used for signing JWT authentication tokens.
# If unset, AegisAI will generate a key securely using the OS Keyring.
# To set manually, use a secure hex string.
# AEGIS_JWT_KEY=

# Password for the default admin account (admin@legalai.local).
# If unset, AegisAI will automatically generate a secure password, log it, and force a password change on first login.
# AEGIS_ADMIN_PASSWORD=

# Enable testing mode for development (seeds mock database records and bypasses Ollama hardware checks)
AEGIS_TEST_MODE=false
OLLAMA_DEFAULT_TIMEOUT=180
